# Agendamento Online — copie para .env.local e preencha. NUNCA versione .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...) ou anon legada. Segura para o navegador: o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Segredo SÓ do servidor (mín. 32 caracteres) que deriva o link de gerenciamento da reserva (HMAC-SHA256).
# Sem ele a reserva pública NÃO funciona (falha fechada). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o valor só afeta o reenvio idempotente de formulários em andamento; links já emitidos continuam valendo (o banco guarda o hash do token).
BOOKING_TOKEN_SECRET=
# O sistema NÃO usa service_role. Não adicione essa chave aqui.
